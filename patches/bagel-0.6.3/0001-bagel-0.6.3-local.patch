+    def _restart_game_after_limit(self, subject: str, limit: int) -> OperationRoundResult | None:
+        """连续失败达到上限时关掉游戏重开再跑；关闭或重启次数用尽时返回 None 走原停止逻辑。
+
+        重开游戏能清掉一局里残留的状态（贴墙、卡在副本、进错画面），是这轮 45 秒点位超时的
+        最后一道自救；重开后连续失败、连续阵亡与各路线失败计数一并清零，避免立刻又撞上限。
+        """
+        if not self.config.restart_game_on_fail_limit:
