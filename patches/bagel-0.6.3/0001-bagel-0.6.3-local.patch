+
+        贴墙或扇形被挡时，``analyze`` 会在两个解之间跳（实测常差 80 度、150 度），
+        直接拿去算目标差会让「停车等转向」每轮换一次方向，位置一步不动直到点位超时。
+        这里把单帧、两三帧的跳变吞掉；连续多帧都一样的跳变才认，保证真转身跟得上。
+
+        Args:
+            sector: 本帧识别到的朝向（度）；None 表示本帧读不到。
+
+        Returns:
+            稳定朝向（度）；尚无稳定值时返回本帧值或 None。
+        """
+        if sector is None:
+            return self.angle_stable
+        stable = self.angle_stable
+        if stable is None:
+            self.angle_stable = sector
+            self.angle_jump_value = None
+            self.angle_jump_frames = 0
+            return sector
+        gap = abs(cal_utils.angle_delta(stable, sector))
+        if gap <= ANGLE_JITTER_TOLERANCE:
+            self.angle_stable = sector
+            self.angle_jump_value = None
+            self.angle_jump_frames = 0
+            return sector
+        if gap < ANGLE_JUMP_IGNORE:
+            # 中幅变化按正常转身处理，逐步跟上去。
+            self.angle_stable = sector
+            self.angle_jump_value = None
+            self.angle_jump_frames = 0
+            return sector
+        same_jump = (
+            self.angle_jump_value is not None
+            and abs(cal_utils.angle_delta(self.angle_jump_value, sector)) <= ANGLE_JITTER_TOLERANCE
+        )
+        self.angle_jump_frames = self.angle_jump_frames + 1 if same_jump else 1
+        self.angle_jump_value = sector
+        if self.angle_jump_frames >= ANGLE_JUMP_PERSIST_FRAMES:
