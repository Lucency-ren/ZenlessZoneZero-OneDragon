+def push_lines(records: list[BagelRouteRecord]) -> list[str]:
+    """推送用的路线汇总：成功入仓、直接重开、被狗击败（阵亡）三类。
+
+    只有 ``成功入仓`` 算成功；没有 ``route_id`` 的是出生点没有可执行路线、
+    入场后直接重开的空转局；阵亡局单独列一行，方便看被怪打死的次数。
+    逐条路线的明细仍然由 :func:`report_lines` 写日志。
+
+    Args:
+        records: 本次运行的记录。
+    """
+    if not records:
+        return []
+    restarts = sum(1 for record in records if record.route_id is None)
+    success = sum(1 for record in records if record.outcome == OUTCOME_SUCCESS)
+    deaths = sum(1 for record in records if record.outcome == OUTCOME_DEFEATED)
+    return [
+        f'成功入仓：{success} 局',
+        f'直接重开：{restarts} 局',
+        f'被狗击败：{deaths} 局',
+    ]
+
+
+def _push_spawn_text(spawn, map_records: list[BagelRouteRecord], restarts: list[BagelRouteRecord],
+                     catalog: BagelRouteCatalog) -> str | None:
+    """一个出生点的一行推送文本；该出生点在本次运行里没有记录时返回 None。
+
+    按记录里实际跑过的路线分组，而不是查 ``active_routes``：开房卡模式的记录里
+    路线是「入口段+房间段」的拼接名，``active_ref`` 拿不到，之前会整行漏掉。
+    """
+    own = [record for record in map_records if record.spawn_id == spawn.spawn_id]
+    if not own:
+        return None
+    routes: dict[str, list[BagelRouteRecord]] = {}
+    idle = 0
+    for record in own:
+        if record.route_id is None:
+            idle += 1
+            continue
+        routes.setdefault(record.route_id, []).append(record)
+    parts: list[str] = []
+    for route_id, rows in sorted(routes.items(), key=lambda item: -len(item[1])):
+        name = rows[0].route_name or route_id
+        if '+' in name:
+            name = f'{name.split("+", 1)[0].strip()}＋房间'
+        success = sum(1 for record in rows if record.outcome == OUTCOME_SUCCESS)
+        piece = f'{name}：打了 {len(rows)} 局 · 成功率 {success / len(rows):.0%}'
+        deaths = sum(1 for record in rows if record.outcome == OUTCOME_DEFEATED)
+        if deaths:
+            piece += f' · 阵亡 {deaths}'
+        known = [record for record in rows if record.income is not None]
+        if known:
+            piece += f' · 每局 {format_value(round(_mean([float(record.income or 0) for record in known])))}'
+        parts.append(piece)
+    if idle:
+        parts.append(f'直接重开：打了 {idle} 局')
+    if not parts:
+        return None
+    return f'{spawn.name} · ' + '；'.join(parts)
+
+
