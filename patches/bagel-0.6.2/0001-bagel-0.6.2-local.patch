+PUSH_LINE_LIMIT: int = 12
+"""推送里最多列多少条路线；超出的省略并注明条数，完整表仍在日志里。"""
+
+
+def push_lines(
+    records: list[BagelRouteRecord], catalog: BagelRouteCatalog, limit: int = PUSH_LINE_LIMIT,
+) -> list[str]:
+    """推送用的路线汇总：每个出生点一行「路线：打了 N 局 · 成功率 X%」。
+
+    只列当前开启路线（本版本）在保留期内有记录的出生点，没记录的不占行；
+    超过 ``limit`` 条的省略并注明条数，完整表见日志。
+
+    Args:
+        records: 保留期内的记录。
+        catalog: 当前路线设置；只统计各出生点当前开启路线的当前版本。
+        limit: 最多列出多少条路线。
+    """
+    lines: list[str] = []
+    omitted = 0
+    map_ids = sorted({record.map_id for record in records if record.map_id is not None})
+    for map_id in map_ids:
+        map_records = [record for record in records if record.map_id == map_id]
+        restarts = [record for record in map_records if record.outcome == OUTCOME_UNSUPPORTED]
+        for spawn in catalog.spawns:
+            if spawn.map_id != map_id:
+                continue
+            text = _push_spawn_text(spawn, map_records, restarts, catalog)
+            if text is None:
+                continue
+            if len(lines) >= limit:
+                omitted += 1
+                continue
+            lines.append(text)
+    if omitted:
+        lines.append(f'…另有 {omitted} 条路线，明细见日志')
+    return lines
+
+
+def _push_spawn_text(spawn, map_records: list[BagelRouteRecord], restarts: list[BagelRouteRecord],
+                     catalog: BagelRouteCatalog) -> str | None:
+    """一个出生点的一行推送文本；该出生点在保留期内没有记录时返回 None。"""
+    ref = catalog.active_ref(spawn.spawn_id)
+    route = catalog.route(ref) if ref is not None else None
+    if route is None:
+        own = [record for record in restarts if record.spawn_id == spawn.spawn_id]
+        if not own:
+            return None
+        return f'{spawn.name} · 直接重开：打了 {len(own)} 局'
+    version = route_version(route)
+    rows = [
+        record for record in map_records
+        if record.spawn_id == spawn.spawn_id and record.route_source == route.source
+        and record.route_id == route.route_id and record.route_version == version
+    ]
+    if not rows:
+        return None
+    success = sum(1 for record in rows if record.outcome == OUTCOME_SUCCESS)
+    text = f'{spawn.name} · {route.name}：打了 {len(rows)} 局 · 成功率 {success / len(rows):.0%}'
+    deaths = sum(1 for record in rows if record.outcome == OUTCOME_DEFEATED)
+    if deaths:
+        text += f' · 阵亡 {deaths}'
+    known = [record for record in rows if record.income is not None]
+    if known:
+        text += f' · 每局 {format_value(round(_mean([float(record.income or 0) for record in known])))}'
+    return text
+
+
